{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Masuk dengan email dan kata sandi",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "summary": "Mencabut session saat ini",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout-all": {
      "post": {
        "operationId": "AuthController_logoutAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Mencabut seluruh session milik pengguna saat ini",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Pengguna saat ini beserta permission efektifnya",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/sessions": {
      "get": {
        "operationId": "AuthController_listSessions",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Perangkat aktif milik pengguna saat ini",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/sessions/{sessionId}": {
      "delete": {
        "operationId": "AuthController_revokeSession",
        "parameters": [
          {
            "name": "sessionId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "summary": "Mencabut satu perangkat milik sendiri",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/courses": {
      "get": {
        "operationId": "CoursesController_list",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "level",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "BEGINNER",
                "INTERMEDIATE",
                "ADVANCED"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Katalog kursus yang sudah terbit",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/v1/courses/{courseId}": {
      "get": {
        "operationId": "CoursesController_detail",
        "parameters": [
          {
            "name": "courseId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Detail kursus beserta status akses pengguna",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/v1/me/enrollments": {
      "get": {
        "operationId": "MyEnrollmentsController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Kursus yang dapat diakses pengguna saat ini",
        "tags": [
          "enrollment"
        ]
      }
    },
    "/api/v1/learn/courses/{courseId}": {
      "get": {
        "operationId": "LearnController_course",
        "parameters": [
          {
            "name": "courseId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Kurikulum dan progres untuk kursus yang diikuti",
        "tags": [
          "learning-delivery"
        ]
      }
    },
    "/api/v1/learn/lessons/{lessonId}": {
      "get": {
        "operationId": "LearnController_lesson",
        "parameters": [
          {
            "name": "lessonId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Isi satu pelajaran",
        "tags": [
          "learning-delivery"
        ]
      }
    },
    "/api/v1/learn/lessons/{lessonId}/open": {
      "post": {
        "operationId": "LessonProgressController_open",
        "parameters": [
          {
            "name": "lessonId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenLessonDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Mencatat bahwa pelajaran dibuka",
        "tags": [
          "learning-progress"
        ]
      }
    },
    "/api/v1/learn/lessons/{lessonId}/complete": {
      "post": {
        "operationId": "LessonProgressController_complete",
        "parameters": [
          {
            "name": "lessonId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "idempotency-key",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "UUID. Percobaan ulang dengan kunci dan isi yang sama mengembalikan respons pertama. Bila tidak dikirim, operasi tetap aman diulang karena penyelesaian pelajaran bersifat idempotent.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteLessonDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Menandai pelajaran selesai",
        "tags": [
          "learning-progress"
        ]
      }
    },
    "/api/v1/health/live": {
      "get": {
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "HealthController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "LMS API",
    "description": "REST API LMS Akademi Online. Autentikasi memakai session opaque pada cookie HttpOnly; mutation memerlukan header X-CSRF-Token.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "lms_session"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "pelajar@akademionline.id"
          },
          "password": {
            "type": "string",
            "example": "Pelajar#12345",
            "minLength": 12
          },
          "deviceName": {
            "type": "string",
            "example": "Chrome di macOS"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "OpenLessonDto": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string"
          }
        }
      },
      "CompletionEvidenceDto": {
        "type": "object",
        "properties": {
          "activeSeconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 86400
          },
          "videoPercentage": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        }
      },
      "CompleteLessonDto": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "ID sesi belajar di sisi klien"
          },
          "completionEvidence": {
            "$ref": "#/components/schemas/CompletionEvidenceDto"
          }
        }
      }
    }
  }
}
