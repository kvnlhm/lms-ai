// Skema ini mengikuti docs/database/ERD.md.
//
// Cakupan walking skeleton: Core Identity, Learning Catalog, Enrollment and
// Progress, serta Transactional Outbox. Domain Community, Communication,
// Analytics agregat, Reporting, dan Media penuh belum dimodelkan di sini dan
// akan ditambahkan lewat migration berikutnya (expand-contract), bukan dengan
// mengubah migration yang sudah dirilis.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pgcrypto]
}

// ─────────────────────────────────────────────────────────────
// Enum
// ─────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  REMOVED
  EXPIRED
}

enum LessonContentType {
  VIDEO
  TEXT
  PDF
  EXTERNAL_LINK
  QUIZ
}

/// SINGLE_CHOICE tepat satu jawaban benar; MULTIPLE_CHOICE menuntut seluruh
/// pilihan benar terpilih dan tidak satu pun yang salah. Benar/salah tidak
/// dibuat sebagai jenis tersendiri karena penilaiannya sama persis dengan
/// SINGLE_CHOICE berisi dua pilihan.
enum QuizQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum CompletionRule {
  MANUAL
  OPENED
  MINIMUM_ACTIVE_SECONDS
  VIDEO_PERCENTAGE
}

/// Satu mekanisme token untuk dua keperluan: undangan akun baru dan
/// pemulihan kata sandi. Keduanya sama-sama sekali pakai, di-hash, dan
/// kedaluwarsa, jadi memisahkannya hanya akan menduplikasi aturan.
enum CredentialTokenPurpose {
  INVITATION
  PASSWORD_RESET
}

enum MfaMethodType {
  TOTP
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum VideoProvider {
  SELF_HOSTED
  BUNNY_STREAM
  YOUTUBE
}

enum VideoStatus {
  CREATED
  UPLOADING
  PROCESSING
  AVAILABLE
  FAILED
  DELETED
}

enum PlaybackStatus {
  ACTIVE
  ENDED
  EXPIRED
  REVOKED
}

enum PaymentOrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  MIDTRANS
}

enum DeliveryStatus {
  PENDING
  SENT
  /// Terkonfirmasi diterima di sisi penerima, menurut webhook penyedianya.
  /// `SENT` semata cuma berarti penyedia menerima permintaan kita, dan pesan
  /// yang sudah diterima penyedia masih bisa gagal diantar tanpa satu pun
  /// jejak di sisi pengirim.
  DELIVERED
  SKIPPED
  FAILED
}

// ─────────────────────────────────────────────────────────────
// Core Identity
// ─────────────────────────────────────────────────────────────

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique @db.Citext
  passwordHash    String     @map("password_hash")
  fullName        String     @map("full_name")
  phone           String?
  bio             String?
  avatarUrl       String?    @map("avatar_url")
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  roles                  UserRole[]
  sessions               AuthSession[]
  resetTokens            PasswordResetToken[]
  mfaMethods             MfaMethod[]
  enrollments            Enrollment[]            @relation("EnrollmentOwner")
  enrollmentsMade        Enrollment[]            @relation("EnrollmentActor")
  createdCourses         Course[]
  auditLogs              AuditLog[]
  videoAssets            VideoAsset[]            @relation("VideoAssetCreator")
  playbackSessions       VideoPlaybackSession[]
  notificationPreference NotificationPreference?
  registrationOrders     RegistrationOrder[]     @relation("ProvisionedRegistrationUser")
  forumTopics            ForumTopic[]            @relation("ForumTopicAuthor")
  forumReplies           ForumReply[]            @relation("ForumReplyAuthor")
  forumReactions         ForumReaction[]         @relation("ForumReactionUser")
  forumReports           ForumReport[]           @relation("ForumReportReporter")
  forumBans              ForumBan[]              @relation("ForumBanUser")
  forumBansIssued        ForumBan[]              @relation("ForumBanIssuer")
  liveSessions           LiveSession[]           @relation("LiveSessionCreator")
  notifications          Notification[]          @relation("NotificationRecipient")
  announcements          Announcement[]          @relation("AnnouncementCreator")
  announcementTargets    AnnouncementTarget[]    @relation("AnnouncementTargetUser")
  announcementReads      AnnouncementRead[]      @relation("AnnouncementReader")
  resolvedErrors         ErrorEvent[]            @relation("ErrorEventResolver")
  bookmarks              UserBookmark[]          @relation("UserBookmarkOwner")
  communityChannelsMade  CommunityChannel[]      @relation("CommunityChannelCreator")
  communityPosts         CommunityPost[]         @relation("CommunityPostAuthor")
  communityComments      CommunityComment[]      @relation("CommunityCommentAuthor")
  communityReactions     CommunityReaction[]     @relation("CommunityReactionUser")

  @@index([status])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// Community feed dan channel (ADR-024)
// ─────────────────────────────────────────────────────────────

/// Ruang percakapan global ala channel. Channel tidak diturunkan dari kursus:
/// seluruh pengguna aktif dapat membacanya, sedangkan pembuatannya hanya lewat
/// endpoint Master.
model CommunityChannel {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique
  name        String
  description String?
  position    Int       @default(0)
  isReadOnly  Boolean   @default(false) @map("is_read_only")
  createdBy   String    @map("created_by") @db.Uuid
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator User            @relation("CommunityChannelCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  posts   CommunityPost[]

  @@index([archivedAt, position])
  @@map("community_channels")
}

model CommunityPost {
  id             String    @id @default(uuid()) @db.Uuid
  channelId      String    @map("channel_id") @db.Uuid
  authorId       String    @map("author_id") @db.Uuid
  body           String
  isPinned       Boolean   @default(false) @map("is_pinned")
  commentCount   Int       @default(0) @map("comment_count")
  reactionCount  Int       @default(0) @map("reaction_count")
  lastActivityAt DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  channel   CommunityChannel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author    User                @relation("CommunityPostAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  comments  CommunityComment[]
  reactions CommunityReaction[]

  @@index([channelId, deletedAt, isPinned, lastActivityAt])
  @@index([authorId, createdAt])
  @@map("community_posts")
}

model CommunityComment {
  id        String    @id @default(uuid()) @db.Uuid
  postId    String    @map("post_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  body      String
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User          @relation("CommunityCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([postId, deletedAt, createdAt])
  @@index([authorId])
  @@map("community_comments")
}

/// MVP memakai satu reaksi suka per pengguna per post.
model CommunityReaction {
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation("CommunityReactionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@map("community_reactions")
}

model NotificationPreference {
  userId                   String   @id @map("user_id") @db.Uuid
  announcementsEnabled     Boolean  @default(true) @map("announcements_enabled")
  courseUpdatesEnabled     Boolean  @default(true) @map("course_updates_enabled")
  learningRemindersEnabled Boolean  @default(true) @map("learning_reminders_enabled")
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique
  name String

  roles RolePermission[]

  @@map("permissions")
}

/// MVP membatasi satu active role per user, ditegakkan lewat @@unique pada userId.
model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@unique([userId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Registry perangkat. Session state sesungguhnya ada di Redis (ADR-010);
/// baris ini hanya untuk daftar perangkat aktif dan pencabutan oleh Master.
model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  deviceName String?   @map("device_name")
  ipAddress  String?   @map("ip_address") @db.Inet
  userAgent  String?   @map("user_agent")
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String                 @id @default(uuid()) @db.Uuid
  userId    String                 @map("user_id") @db.Uuid
  /// Hanya hash yang disimpan; token asli tidak pernah ada di database.
  tokenHash String                 @unique @map("token_hash")
  purpose   CredentialTokenPurpose @default(PASSWORD_RESET)
  expiresAt DateTime               @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?              @map("used_at") @db.Timestamptz(6)
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Faktor kedua untuk autentikasi.
///
/// Rahasianya disimpan terenkripsi (AES-256-GCM) memakai kunci dari
/// environment, sehingga bocornya dump database saja tidak cukup untuk
/// membangkitkan kode yang sah.
model MfaMethod {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  type            MfaMethodType @default(TOTP)
  encryptedSecret Bytes         @map("encrypted_secret")
  isPrimary       Boolean       @default(true) @map("is_primary")
  verifiedAt      DateTime?     @map("verified_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("mfa_methods")
}

// ─────────────────────────────────────────────────────────────
// Learning Catalog
// ─────────────────────────────────────────────────────────────

model CourseCategory {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  courses Course[]

  @@map("course_categories")
}

model Course {
  id               String            @id @default(uuid()) @db.Uuid
  categoryId       String?           @map("category_id") @db.Uuid
  createdBy        String?           @map("created_by") @db.Uuid
  slug             String            @unique
  title            String
  thumbnailUrl     String?           @map("thumbnail_url")
  shortDescription String?           @map("short_description")
  description      String?
  level            CourseLevel       @default(BEGINNER)
  status           PublicationStatus @default(DRAFT)
  estimatedMinutes Int               @default(0) @map("estimated_minutes")
  publishedAt      DateTime?         @map("published_at") @db.Timestamptz(6)
  archivedAt       DateTime?         @map("archived_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  category      CourseCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  creator       User?              @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  modules       CourseModule[]
  enrollments   Enrollment[]
  accessTiers   AccessTierCourse[]
  forumTopics   ForumTopic[]
  forumBans     ForumBan[]
  liveSessions  LiveSession[]
  announcements Announcement[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@map("courses")
}

model CourseModule {
  id               String   @id @default(uuid()) @db.Uuid
  courseId         String   @map("course_id") @db.Uuid
  title            String
  description      String?
  position         Int
  isActive         Boolean  @default(true) @map("is_active")
  estimatedMinutes Int      @default(0) @map("estimated_minutes")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  forumTopics ForumTopic[]

  @@unique([courseId, position])
  @@index([courseId, isActive])
  @@map("course_modules")
}

model Lesson {
  id               String            @id @default(uuid()) @db.Uuid
  moduleId         String            @map("module_id") @db.Uuid
  title            String
  description      String?
  contentType      LessonContentType @default(VIDEO) @map("content_type")
  /// Aset dari perpustakaan video yang dipakai pelajaran ini. Dapat menunjuk
  /// aset yang sama dengan pelajaran lain; penghapusan aset ditolak selama
  /// masih ada yang menunjuknya.
  videoAssetId     String?           @map("video_asset_id") @db.Uuid
  textContent      String?           @map("text_content")
  externalUrl      String?           @map("external_url")
  position         Int
  estimatedMinutes Int               @default(0) @map("estimated_minutes")
  isRequired       Boolean           @default(true) @map("is_required")
  isPreview        Boolean           @default(false) @map("is_preview")
  isActive         Boolean           @default(true) @map("is_active")
  completionRule   CompletionRule    @default(MANUAL) @map("completion_rule")
  completionConfig Json?             @map("completion_config")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  module        CourseModule         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress      LessonProgress[]
  lastForCourse CourseProgress[]     @relation("LastLesson")
  prerequisites LessonPrerequisite[] @relation("LessonSide")
  requiredBy    LessonPrerequisite[] @relation("PrerequisiteSide")
  videoAsset       VideoAsset?          @relation("LessonVideo", fields: [videoAssetId], references: [id], onDelete: Restrict)
  playbackSessions VideoPlaybackSession[]
  forumTopics   ForumTopic[]
  bookmarks     UserBookmark[]
  quiz          Quiz?

  @@unique([moduleId, position])
  @@index([moduleId, isActive])
  @@index([videoAssetId])
  @@map("lessons")
}

model LessonPrerequisite {
  lessonId             String @map("lesson_id") @db.Uuid
  prerequisiteLessonId String @map("prerequisite_lesson_id") @db.Uuid

  lesson       Lesson @relation("LessonSide", fields: [lessonId], references: [id], onDelete: Cascade)
  prerequisite Lesson @relation("PrerequisiteSide", fields: [prerequisiteLessonId], references: [id], onDelete: Cascade)

  @@id([lessonId, prerequisiteLessonId])
  @@map("lesson_prerequisites")
}

// ─────────────────────────────────────────────────────────────
// Quiz (PRD 7.17)
// ─────────────────────────────────────────────────────────────

/// Satu kuis menempel pada satu pelajaran berjenis QUIZ.
///
/// Kuis tidak dibuat sebagai barang perpustakaan seperti aset video: soal
/// selalu ditulis untuk konteks pelajarannya, dan menyalakan pemakaian ulang
/// akan menuntut versi soal tersendiri agar riwayat percobaan lama tetap
/// terbaca.
model Quiz {
  id           String   @id @default(uuid()) @db.Uuid
  lessonId     String   @unique @map("lesson_id") @db.Uuid
  /// Ambang lulus dalam persen, 0 sampai 100.
  passingScore Int      @default(70) @map("passing_score")
  /// Batas percobaan; null berarti tanpa batas.
  maxAttempts  Int?     @map("max_attempts")
  /// Bila benar, jawaban yang benar diperlihatkan setelah pengiriman.
  /// Selama bernilai salah, kunci jawaban tidak pernah meninggalkan server.
  showFeedback Boolean  @default(true) @map("show_feedback")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

model QuizQuestion {
  id          String           @id @default(uuid()) @db.Uuid
  quizId      String           @map("quiz_id") @db.Uuid
  prompt      String
  /// Penjelasan yang ditampilkan bersama umpan balik setelah pengiriman.
  explanation String?
  type        QuizQuestionType @default(SINGLE_CHOICE)
  points      Int              @default(1)
  position    Int
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuizOption[]
  answers QuizAnswer[]

  @@unique([quizId, position])
  @@map("quiz_questions")
}

model QuizOption {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  text       String
  isCorrect  Boolean  @default(false) @map("is_correct")
  position   Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position])
  @@map("quiz_options")
}

/// Satu pengiriman jawaban. Nilai dihitung server dan disimpan di sini, jadi
/// hasil yang pernah dilihat pelajar tetap dapat ditelusuri meskipun soalnya
/// kemudian diubah Master.
model QuizAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  quizId        String   @map("quiz_id") @db.Uuid
  enrollmentId  String   @map("enrollment_id") @db.Uuid
  attemptNumber Int      @map("attempt_number")
  scorePercent  Decimal  @map("score_percent") @db.Decimal(5, 2)
  earnedPoints  Int      @map("earned_points")
  totalPoints   Int      @map("total_points")
  passed        Boolean
  submittedAt   DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  quiz       Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  enrollment Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  answers    QuizAnswer[]

  // Nomor percobaan unik per peserta menjadi penjaga balapan: dua pengiriman
  // bersamaan tidak dapat sama-sama menjadi percobaan ke-3, sehingga batas
  // percobaan tidak bisa dilewati dengan menekan kirim dua kali.
  @@unique([quizId, enrollmentId, attemptNumber])
  @@index([enrollmentId, submittedAt])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id                String   @id @default(uuid()) @db.Uuid
  attemptId         String   @map("attempt_id") @db.Uuid
  questionId        String   @map("question_id") @db.Uuid
  /// Pilihan yang ditandai pelajar. Disimpan sebagai larik agar satu baris
  /// mewakili satu soal, termasuk soal berjawaban ganda.
  selectedOptionIds String[] @map("selected_option_ids") @db.Uuid
  isCorrect         Boolean  @map("is_correct")
  earnedPoints      Int      @map("earned_points")

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("quiz_answers")
}

// ─────────────────────────────────────────────────────────────
// Enrollment and Progress
// ─────────────────────────────────────────────────────────────

model Enrollment {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  courseId       String           @map("course_id") @db.Uuid
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  accessStartsAt DateTime?        @map("access_starts_at") @db.Timestamptz(6)
  accessEndsAt   DateTime?        @map("access_ends_at") @db.Timestamptz(6)
  completedAt    DateTime?        @map("completed_at") @db.Timestamptz(6)
  removedAt      DateTime?        @map("removed_at") @db.Timestamptz(6)
  enrolledBy     String?          @map("enrolled_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user             User                   @relation("EnrollmentOwner", fields: [userId], references: [id], onDelete: Cascade)
  course           Course                 @relation(fields: [courseId], references: [id], onDelete: Restrict)
  actor            User?                  @relation("EnrollmentActor", fields: [enrolledBy], references: [id], onDelete: SetNull)
  courseProgress   CourseProgress?
  lessonProgress   LessonProgress[]
  playbackSessions VideoPlaybackSession[]
  quizAttempts     QuizAttempt[]

  @@unique([userId, courseId])
  @@index([courseId, status])
  @@map("enrollments")
}

// ─────────────────────────────────────────────────────────────
// Registration Commerce
// ─────────────────────────────────────────────────────────────

model AccessTier {
  id             String   @id @default(uuid()) @db.Uuid
  slug           String   @unique
  name           String
  description    String?
  priceIdr       Int      @map("price_idr")
  /// Harga sebelum diskon, untuk ditampilkan tercoret di samping harga jual.
  /// Opsional: paket tanpa nilai ini tampil dengan satu harga saja.
  originalPriceIdr Int?   @map("original_price_idr")
  durationMonths Int?     @map("duration_months")
  isActive       Boolean  @default(true) @map("is_active")
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  courses AccessTierCourse[]
  orders  RegistrationOrder[]

  @@index([isActive, position])
  @@map("access_tiers")
}

model AccessTierCourse {
  tierId   String @map("tier_id") @db.Uuid
  courseId String @map("course_id") @db.Uuid
  position Int    @default(0)

  tier   AccessTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  course Course     @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@id([tierId, courseId])
  @@unique([tierId, position])
  @@map("access_tier_courses")
}

model RegistrationOrder {
  id                     String             @id @default(uuid()) @db.Uuid
  orderCode              String             @unique @map("order_code")
  tierId                 String             @map("tier_id") @db.Uuid
  fullName               String             @map("full_name")
  email                  String             @db.Citext
  phone                  String
  grossAmount            Int                @map("gross_amount")
  status                 PaymentOrderStatus @default(PENDING)
  paymentProvider        PaymentProvider    @default(MIDTRANS) @map("payment_provider")
  snapToken              String?            @map("snap_token")
  redirectUrl            String?            @map("redirect_url")
  providerTransactionId  String?            @map("provider_transaction_id")
  paymentType            String?            @map("payment_type")
  fraudStatus            String?            @map("fraud_status")
  paidAt                 DateTime?          @map("paid_at") @db.Timestamptz(6)
  accessStartsAt         DateTime?          @map("access_starts_at") @db.Timestamptz(6)
  accessEndsAt           DateTime?          @map("access_ends_at") @db.Timestamptz(6)
  provisionedUserId      String?            @map("provisioned_user_id") @db.Uuid
  emailDeliveryStatus    DeliveryStatus     @default(PENDING) @map("email_delivery_status")
  whatsAppDeliveryStatus DeliveryStatus     @default(PENDING) @map("whatsapp_delivery_status")
  /// Id dari balasan Resend, pegangan untuk mencocokkan webhook status
  /// pengantaran email dengan ordernya.
  emailMessageId         String?            @unique @map("email_message_id")
  /// `wamid` dari balasan Meta, satu-satunya pegangan untuk mencocokkan
  /// webhook status pengantaran dengan ordernya.
  whatsAppMessageId      String?            @unique @map("whatsapp_message_id")
  deliveryError          String?            @map("delivery_error")
  expiresAt              DateTime           @map("expires_at") @db.Timestamptz(6)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tier            AccessTier            @relation(fields: [tierId], references: [id], onDelete: Restrict)
  provisionedUser User?                 @relation("ProvisionedRegistrationUser", fields: [provisionedUserId], references: [id], onDelete: SetNull)
  webhookEvents   PaymentWebhookEvent[]

  @@index([email, status])
  @@index([status, createdAt])
  @@map("registration_orders")
}

model PaymentWebhookEvent {
  id               String    @id @default(uuid()) @db.Uuid
  orderId          String    @map("order_id") @db.Uuid
  providerEventKey String    @unique @map("provider_event_key")
  payload          Json
  receivedAt       DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt      DateTime? @map("processed_at") @db.Timestamptz(6)

  order RegistrationOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, receivedAt])
  @@map("payment_webhook_events")
}

/// Aset video adalah barang perpustakaan yang berdiri sendiri, bukan milik satu
/// pelajaran. Pelajaran yang menunjuk ke aset lewat `lessons.video_asset_id`,
/// sehingga satu berkas dapat dipakai berapa pun pelajaran tanpa disalin.
model VideoAsset {
  id              String        @id @default(uuid()) @db.Uuid
  createdBy       String        @map("created_by") @db.Uuid
  provider        VideoProvider @default(SELF_HOSTED)
  providerVideoId String        @unique @map("provider_video_id")
  objectKey       String?       @map("object_key")
  // Kosong untuk video yang tidak diunggah ke sini, misalnya YOUTUBE:
  // tidak ada berkas, tipe MIME, maupun ukuran yang kita kuasai.
  originalName    String?       @map("original_name")
  title           String
  mimeType        String?       @map("mime_type")
  sizeBytes       BigInt?       @map("size_bytes")
  // URL kanonis di penyedia eksternal. Hanya terisi untuk provider eksternal.
  sourceUrl       String?       @map("source_url")
  status          VideoStatus   @default(CREATED)
  processingError String?       @map("processing_error")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)

  creator          User                   @relation("VideoAssetCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  playbackSessions VideoPlaybackSession[]
  lessons          Lesson[]               @relation("LessonVideo")

  @@index([status])
  @@map("video_assets")
}

model VideoPlaybackSession {
  id              String         @id @default(uuid()) @db.Uuid
  videoAssetId    String         @map("video_asset_id") @db.Uuid
  /// Pelajaran yang sedang dibuka pelajar saat sesi dibuat.
  ///
  /// Disimpan sendiri, bukan diturunkan dari asetnya: satu aset kini dapat
  /// dipakai banyak pelajaran, sehingga aset tidak lagi dapat menjawab
  /// "pelajaran mana yang haknya harus diperiksa". Tanpa kolom ini, pelajar
  /// yang berhak atas satu pelajaran dapat memutar berkas lewat konteks
  /// pelajaran lain yang kebetulan memakai video sama.
  lessonId        String         @map("lesson_id") @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  enrollmentId    String         @map("enrollment_id") @db.Uuid
  deviceId        String?        @map("device_id")
  status          PlaybackStatus @default(ACTIVE)
  expiresAt       DateTime       @map("expires_at") @db.Timestamptz(6)
  startedAt       DateTime       @default(now()) @map("started_at") @db.Timestamptz(6)
  lastHeartbeatAt DateTime?      @map("last_heartbeat_at") @db.Timestamptz(6)
  endedAt         DateTime?      @map("ended_at") @db.Timestamptz(6)

  videoAsset VideoAsset @relation(fields: [videoAssetId], references: [id], onDelete: Restrict)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  @@index([userId, status, expiresAt])
  @@index([videoAssetId, status])
  @@index([lessonId])
  @@map("video_playback_sessions")
}

model CourseProgress {
  id                      String    @id @default(uuid()) @db.Uuid
  enrollmentId            String    @unique @map("enrollment_id") @db.Uuid
  requiredLessonsTotal    Int       @default(0) @map("required_lessons_total")
  requiredLessonsComplete Int       @default(0) @map("required_lessons_completed")
  progressPercent         Decimal   @default(0) @map("progress_percent") @db.Decimal(5, 2)
  lastLessonId            String?   @map("last_lesson_id") @db.Uuid
  startedAt               DateTime? @map("started_at") @db.Timestamptz(6)
  lastActivityAt          DateTime? @map("last_activity_at") @db.Timestamptz(6)
  completedAt             DateTime? @map("completed_at") @db.Timestamptz(6)
  version                 Int       @default(0)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lastLesson Lesson?    @relation("LastLesson", fields: [lastLessonId], references: [id], onDelete: SetNull)

  @@map("course_progress")
}

model LessonProgress {
  id                 String               @id @default(uuid()) @db.Uuid
  enrollmentId       String               @map("enrollment_id") @db.Uuid
  lessonId           String               @map("lesson_id") @db.Uuid
  status             LessonProgressStatus @default(NOT_STARTED)
  viewCount          Int                  @default(0) @map("view_count")
  totalSeconds       Int                  @default(0) @map("total_seconds")
  firstOpenedAt      DateTime?            @map("first_opened_at") @db.Timestamptz(6)
  lastOpenedAt       DateTime?            @map("last_opened_at") @db.Timestamptz(6)
  completedAt        DateTime?            @map("completed_at") @db.Timestamptz(6)
  completionEvidence Json?                @map("completion_evidence")
  version            Int                  @default(0)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([lessonId, status])
  @@map("lesson_progress")
}

// ─────────────────────────────────────────────────────────────
// Transactional Outbox (ADR-004)
// ─────────────────────────────────────────────────────────────

model OutboxMessage {
  id            String    @id @default(uuid()) @db.Uuid
  eventId       String    @unique @map("event_id") @db.Uuid
  eventType     String    @map("event_type")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json
  schemaVersion Int       @default(1) @map("schema_version")
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")

  @@index([publishedAt, availableAt])
  @@map("outbox_messages")
}

/// Fakta perilaku belajar, ditulis worker dari outbox.
///
/// `eventUuid` menyimpan `outbox_messages.event_id`. Constraint unik pada kolom
/// itulah yang membuat konsumer idempotent: percobaan kedua atas event yang
/// sama gagal pada level database, bukan bergantung pada disiplin kode.
model LearningEvent {
  id              BigInt   @id @default(autoincrement())
  eventUuid       String   @unique @map("event_uuid") @db.Uuid
  eventName       String   @map("event_name")
  schemaVersion   Int      @default(1) @map("schema_version")
  userId          String?  @map("user_id") @db.Uuid
  learningSession String?  @map("session_id") @db.Uuid
  courseId        String?  @map("course_id") @db.Uuid
  moduleId        String?  @map("module_id") @db.Uuid
  lessonId        String?  @map("lesson_id") @db.Uuid
  occurredAt      DateTime @map("occurred_at") @db.Timestamptz(6)
  durationSeconds Int?     @map("duration_seconds")
  deviceType      String?  @map("device_type")
  source          String?
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, occurredAt])
  @@index([courseId, eventName, occurredAt])
  @@index([lessonId, eventName])
  @@map("learning_events")
}

/// Menyimpan hasil mutation idempotent supaya percobaan ulang dengan
/// Idempotency-Key yang sama mengembalikan respons yang sama.
model IdempotencyKey {
  id           String   @id @default(uuid()) @db.Uuid
  key          String
  userId       String   @map("user_id") @db.Uuid
  endpoint     String
  requestHash  String   @map("request_hash")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([userId, endpoint, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id") @db.Uuid
  beforeData  Json?    @map("before_data")
  afterData   Json?    @map("after_data")
  requestId   String?  @map("request_id") @db.Uuid
  ipAddress   String?  @map("ip_address") @db.Inet
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

enum ForumTopicStatus {
  OPEN
  RESOLVED
  LOCKED
  HIDDEN
}

enum ForumReportStatus {
  PENDING
  ACTIONED
  DISMISSED
}

/// Topik diskusi. Selalu terikat ke satu kursus karena hak akses forum
/// diturunkan dari enrollment kursus tersebut; modul dan pelajaran hanya
/// mempersempit konteksnya.
model ForumTopic {
  id               String           @id @default(uuid()) @db.Uuid
  courseId         String           @map("course_id") @db.Uuid
  moduleId         String?          @map("module_id") @db.Uuid
  lessonId         String?          @map("lesson_id") @db.Uuid
  authorId         String           @map("author_id") @db.Uuid
  title            String
  body             String
  status           ForumTopicStatus @default(OPEN)
  isPinned         Boolean          @default(false) @map("is_pinned")
  bestReplyId      String?          @unique @map("best_reply_id") @db.Uuid
  replyCount       Int              @default(0) @map("reply_count")
  lastActivityAt   DateTime         @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  // Identitas moderator disimpan untuk jejak singkat; audit_logs tetap otoritas.
  moderatedBy      String?          @map("moderated_by") @db.Uuid
  moderatedAt      DateTime?        @map("moderated_at") @db.Timestamptz(6)
  moderationReason String?          @map("moderation_reason")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(6)

  course    Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module    CourseModule?   @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  lesson    Lesson?         @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  author    User            @relation("ForumTopicAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  bestReply ForumReply?     @relation("ForumTopicBestReply", fields: [bestReplyId], references: [id], onDelete: SetNull)
  replies   ForumReply[]    @relation("ForumTopicReplies")
  reactions ForumReaction[]
  reports   ForumReport[]

  @@index([courseId, status, isPinned, lastActivityAt])
  @@index([lessonId])
  @@index([authorId])
  @@map("forum_topics")
}

model ForumReply {
  id               String    @id @default(uuid()) @db.Uuid
  topicId          String    @map("topic_id") @db.Uuid
  authorId         String    @map("author_id") @db.Uuid
  body             String
  isHidden         Boolean   @default(false) @map("is_hidden")
  moderatedBy      String?   @map("moderated_by") @db.Uuid
  moderatedAt      DateTime? @map("moderated_at") @db.Timestamptz(6)
  moderationReason String?   @map("moderation_reason")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  topic        ForumTopic      @relation("ForumTopicReplies", fields: [topicId], references: [id], onDelete: Cascade)
  bestForTopic ForumTopic?     @relation("ForumTopicBestReply")
  author       User            @relation("ForumReplyAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reactions    ForumReaction[]
  reports      ForumReport[]

  @@index([topicId, createdAt])
  @@index([authorId])
  @@map("forum_replies")
}

/// Reaksi menempel pada topik atau balasan, tidak pernah keduanya.
model ForumReaction {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  topicId   String?  @map("topic_id") @db.Uuid
  replyId   String?  @map("reply_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User        @relation("ForumReactionUser", fields: [userId], references: [id], onDelete: Cascade)
  topic ForumTopic? @relation(fields: [topicId], references: [id], onDelete: Cascade)
  reply ForumReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@unique([userId, replyId])
  @@map("forum_reactions")
}

/// Laporan konten dari pelajar. Masuk daftar review Master (PRD 7.12).
model ForumReport {
  id         String            @id @default(uuid()) @db.Uuid
  reporterId String            @map("reporter_id") @db.Uuid
  topicId    String?           @map("topic_id") @db.Uuid
  replyId    String?           @map("reply_id") @db.Uuid
  reason     String
  status     ForumReportStatus @default(PENDING)
  reviewedBy String?           @map("reviewed_by") @db.Uuid
  reviewedAt DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  reporter User        @relation("ForumReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  topic    ForumTopic? @relation(fields: [topicId], references: [id], onDelete: Cascade)
  reply    ForumReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("forum_reports")
}

/// Pencabutan hak berpartisipasi di forum. `courseId` null berarti berlaku di
/// seluruh forum. Blokir dicabut dengan mengisi `revokedAt`, bukan menghapus
/// barisnya, agar riwayat moderasi tetap utuh.
model ForumBan {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  courseId  String?   @map("course_id") @db.Uuid
  reason    String
  issuedBy  String    @map("issued_by") @db.Uuid
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy String?   @map("revoked_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User    @relation("ForumBanUser", fields: [userId], references: [id], onDelete: Cascade)
  issuer User    @relation("ForumBanIssuer", fields: [issuedBy], references: [id], onDelete: Restrict)
  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([courseId, revokedAt])
  @@map("forum_bans")
}

/// Sesi belajar langsung. Tautannya ditempel Master secara manual (ADR-019),
/// jadi LMS tidak memanggil API penyedia apa pun dan tidak menyimpan kredensial
/// Zoom maupun Meet.
model LiveSession {
  id              String    @id @default(uuid()) @db.Uuid
  courseId        String    @map("course_id") @db.Uuid
  title           String
  description     String?
  joinUrl         String    @map("join_url")
  startsAt        DateTime  @map("starts_at") @db.Timestamptz(6)
  durationMinutes Int       @default(60) @map("duration_minutes")
  createdBy       String    @map("created_by") @db.Uuid
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creator User   @relation("LiveSessionCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([courseId, startsAt])
  @@map("live_sessions")
}

/// Jenis notifikasi mengikuti daftar trigger PRD 7.14, ditambah dua kejadian
/// forum yang dicatat sebagai kekurangan pada ADR-018.
enum NotificationType {
  ENROLLED_IN_COURSE
  FORUM_REPLY
  FORUM_BEST_ANSWER
  FORUM_PARTICIPATION_REVOKED
  FORUM_PARTICIPATION_RESTORED
  COURSE_COMPLETED
  LIVE_SESSION_SCHEDULED
  FORUM_NEW_TOPIC
  FORUM_CONTENT_REPORTED
  ANNOUNCEMENT_PUBLISHED
}

/// Notifikasi dalam aplikasi. Channel MVP hanya in-app (PRD 7.14); pengiriman
/// email menyusul lewat modul communication tanpa mengubah tabel ini.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String
  /// Tautan relatif ke objek terkait, wajib menurut acceptance criteria PRD.
  linkUrl   String?          @map("link_url")
  readAt    DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

enum AnnouncementAudience {
  ALL_USERS
  COURSE_LEARNERS
  SPECIFIC_USERS
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Pengumuman dari Master (PRD 7.13).
///
/// Terbit tidak sama dengan tampil: `publishedAt` boleh berada di masa depan
/// sehingga Master dapat menjadwalkan, dan `endsAt` membuatnya berhenti tampil
/// tanpa perlu dihapus.
model Announcement {
  id          String               @id @default(uuid()) @db.Uuid
  title       String
  body        String
  audience    AnnouncementAudience @default(ALL_USERS)
  status      AnnouncementStatus   @default(DRAFT)
  /// Hanya untuk audience COURSE_LEARNERS.
  courseId    String?              @map("course_id") @db.Uuid
  publishedAt DateTime?            @map("published_at") @db.Timestamptz(6)
  endsAt      DateTime?            @map("ends_at") @db.Timestamptz(6)
  /// Penanda bahwa penerimanya sudah diberi tahu.
  ///
  /// Diperlukan karena pengumuman terjadwal diberitahukan oleh pekerjaan latar,
  /// bukan oleh tindakan menerbitkan. Tanpa penanda ini, setiap siklus akan
  /// mengirim notifikasi yang sama berulang kali.
  notifiedAt  DateTime?            @map("notified_at") @db.Timestamptz(6)
  createdBy   String               @map("created_by") @db.Uuid
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  course    Course?              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creator   User                 @relation("AnnouncementCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  targets   AnnouncementTarget[]
  readState AnnouncementRead[]

  @@index([status, publishedAt, endsAt])
  @@index([status, notifiedAt, publishedAt])
  @@map("announcements")
}

/// Penerima untuk audience SPECIFIC_USERS.
model AnnouncementTarget {
  announcementId String @map("announcement_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation("AnnouncementTargetUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@index([userId])
  @@map("announcement_targets")
}

/// Penanda sudah dibaca, diwajibkan acceptance criteria PRD 7.13.
model AnnouncementRead {
  announcementId String   @map("announcement_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  readAt         DateTime @default(now()) @map("read_at") @db.Timestamptz(6)

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation("AnnouncementReader", fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@map("announcement_reads")
}

// ── Pemantauan galat (PRD 12.7) ────────────────────────────────

enum ErrorSource {
  API
  WEB
  WORKER
}

enum ErrorStatus {
  OPEN
  RESOLVED
}

/// Satu baris per jenis galat, bukan per kejadian.
///
/// Galat yang sama pada satu endpoint bisa terjadi ribuan kali dalam semenit;
/// menyimpannya satu per satu membuat tabel ini menjadi beban tersendiri saat
/// sistem sedang bermasalah — persis saat ia paling dibutuhkan. Pengelompokan
/// memakai `fingerprint` sehingga jumlahnya bertambah, bukan barisnya.
model ErrorEvent {
  id          BigInt      @id @default(autoincrement())
  fingerprint String      @unique
  source      ErrorSource
  status      ErrorStatus @default(OPEN)
  /// Nama kelas exception, atau `Error` bila tidak diketahui.
  type        String
  message     String
  /// Jejak tumpukan kejadian terakhir, dipangkas.
  stack       String?
  /// Konteks kejadian terakhir: method, path, statusCode, requestId, userId.
  /// Sengaja tanpa email atau nama agar galat tidak menjadi sumber PII baru.
  context     Json?
  occurrences Int         @default(1)
  firstSeenAt DateTime    @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt  DateTime    @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  resolvedAt  DateTime?   @map("resolved_at") @db.Timestamptz(6)
  resolvedBy  String?     @map("resolved_by") @db.Uuid
  /// Peringatan terakhir; menahan surat susulan untuk galat yang itu-itu juga.
  alertedAt   DateTime?   @map("alerted_at") @db.Timestamptz(6)

  resolver User? @relation("ErrorEventResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([status, lastSeenAt])
  @@index([source, lastSeenAt])
  @@map("error_events")
}

/// Materi yang ditandai pelajar untuk dibuka kembali (PRD 14, backlog P1).
///
/// Bookmark bukan progres: menghapusnya tidak mengubah apa pun tentang
/// penyelesaian materi, dan kehilangannya tidak merusak riwayat belajar.
model UserBookmark {
  userId    String   @map("user_id") @db.Uuid
  lessonId  String   @map("lesson_id") @db.Uuid
  /// Catatan pribadi pelajar; tidak pernah terlihat pengguna lain.
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User   @relation("UserBookmarkOwner", fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@index([userId, createdAt])
  @@map("user_bookmarks")
}
