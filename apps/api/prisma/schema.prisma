// Skema ini mengikuti docs/database/ERD.md.
//
// Cakupan walking skeleton: Core Identity, Learning Catalog, Enrollment and
// Progress, serta Transactional Outbox. Domain Community, Communication,
// Analytics agregat, Reporting, dan Media penuh belum dimodelkan di sini dan
// akan ditambahkan lewat migration berikutnya (expand-contract), bukan dengan
// mengubah migration yang sudah dirilis.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pgcrypto]
}

// ─────────────────────────────────────────────────────────────
// Enum
// ─────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  REMOVED
  EXPIRED
}

enum LessonContentType {
  VIDEO
  TEXT
  PDF
  EXTERNAL_LINK
}

enum CompletionRule {
  MANUAL
  OPENED
  MINIMUM_ACTIVE_SECONDS
  VIDEO_PERCENTAGE
}

/// Satu mekanisme token untuk dua keperluan: undangan akun baru dan
/// pemulihan kata sandi. Keduanya sama-sama sekali pakai, di-hash, dan
/// kedaluwarsa, jadi memisahkannya hanya akan menduplikasi aturan.
enum CredentialTokenPurpose {
  INVITATION
  PASSWORD_RESET
}

enum MfaMethodType {
  TOTP
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum VideoProvider {
  SELF_HOSTED
  BUNNY_STREAM
}

enum VideoStatus {
  CREATED
  UPLOADING
  PROCESSING
  AVAILABLE
  FAILED
  DELETED
}

enum PlaybackStatus {
  ACTIVE
  ENDED
  EXPIRED
  REVOKED
}

enum PaymentOrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  MIDTRANS
}

enum DeliveryStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
}

// ─────────────────────────────────────────────────────────────
// Core Identity
// ─────────────────────────────────────────────────────────────

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique @db.Citext
  passwordHash    String     @map("password_hash")
  fullName        String     @map("full_name")
  phone           String?
  bio             String?
  avatarUrl       String?    @map("avatar_url")
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  roles                  UserRole[]
  sessions               AuthSession[]
  resetTokens            PasswordResetToken[]
  mfaMethods             MfaMethod[]
  enrollments            Enrollment[]            @relation("EnrollmentOwner")
  enrollmentsMade        Enrollment[]            @relation("EnrollmentActor")
  createdCourses         Course[]
  auditLogs              AuditLog[]
  videoAssets            VideoAsset[]            @relation("VideoAssetCreator")
  playbackSessions       VideoPlaybackSession[]
  notificationPreference NotificationPreference?
  registrationOrders     RegistrationOrder[]     @relation("ProvisionedRegistrationUser")

  @@index([status])
  @@map("users")
}

model NotificationPreference {
  userId                   String   @id @map("user_id") @db.Uuid
  announcementsEnabled     Boolean  @default(true) @map("announcements_enabled")
  courseUpdatesEnabled     Boolean  @default(true) @map("course_updates_enabled")
  learningRemindersEnabled Boolean  @default(true) @map("learning_reminders_enabled")
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique
  name String

  roles RolePermission[]

  @@map("permissions")
}

/// MVP membatasi satu active role per user, ditegakkan lewat @@unique pada userId.
model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@unique([userId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Registry perangkat. Session state sesungguhnya ada di Redis (ADR-010);
/// baris ini hanya untuk daftar perangkat aktif dan pencabutan oleh Master.
model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  deviceName String?   @map("device_name")
  ipAddress  String?   @map("ip_address") @db.Inet
  userAgent  String?   @map("user_agent")
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String                 @id @default(uuid()) @db.Uuid
  userId    String                 @map("user_id") @db.Uuid
  /// Hanya hash yang disimpan; token asli tidak pernah ada di database.
  tokenHash String                 @unique @map("token_hash")
  purpose   CredentialTokenPurpose @default(PASSWORD_RESET)
  expiresAt DateTime               @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?              @map("used_at") @db.Timestamptz(6)
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Faktor kedua untuk autentikasi.
///
/// Rahasianya disimpan terenkripsi (AES-256-GCM) memakai kunci dari
/// environment, sehingga bocornya dump database saja tidak cukup untuk
/// membangkitkan kode yang sah.
model MfaMethod {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  type            MfaMethodType @default(TOTP)
  encryptedSecret Bytes         @map("encrypted_secret")
  isPrimary       Boolean       @default(true) @map("is_primary")
  verifiedAt      DateTime?     @map("verified_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("mfa_methods")
}

// ─────────────────────────────────────────────────────────────
// Learning Catalog
// ─────────────────────────────────────────────────────────────

model CourseCategory {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  courses Course[]

  @@map("course_categories")
}

model Course {
  id               String            @id @default(uuid()) @db.Uuid
  categoryId       String?           @map("category_id") @db.Uuid
  createdBy        String?           @map("created_by") @db.Uuid
  slug             String            @unique
  title            String
  thumbnailUrl     String?           @map("thumbnail_url")
  shortDescription String?           @map("short_description")
  description      String?
  level            CourseLevel       @default(BEGINNER)
  status           PublicationStatus @default(DRAFT)
  estimatedMinutes Int               @default(0) @map("estimated_minutes")
  publishedAt      DateTime?         @map("published_at") @db.Timestamptz(6)
  archivedAt       DateTime?         @map("archived_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  category    CourseCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  creator     User?              @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  modules     CourseModule[]
  enrollments Enrollment[]
  accessTiers AccessTierCourse[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@map("courses")
}

model CourseModule {
  id               String   @id @default(uuid()) @db.Uuid
  courseId         String   @map("course_id") @db.Uuid
  title            String
  description      String?
  position         Int
  isActive         Boolean  @default(true) @map("is_active")
  estimatedMinutes Int      @default(0) @map("estimated_minutes")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, position])
  @@index([courseId, isActive])
  @@map("course_modules")
}

model Lesson {
  id               String            @id @default(uuid()) @db.Uuid
  moduleId         String            @map("module_id") @db.Uuid
  title            String
  description      String?
  contentType      LessonContentType @default(VIDEO) @map("content_type")
  textContent      String?           @map("text_content")
  externalUrl      String?           @map("external_url")
  position         Int
  estimatedMinutes Int               @default(0) @map("estimated_minutes")
  isRequired       Boolean           @default(true) @map("is_required")
  isPreview        Boolean           @default(false) @map("is_preview")
  isActive         Boolean           @default(true) @map("is_active")
  completionRule   CompletionRule    @default(MANUAL) @map("completion_rule")
  completionConfig Json?             @map("completion_config")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  module        CourseModule         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress      LessonProgress[]
  lastForCourse CourseProgress[]     @relation("LastLesson")
  prerequisites LessonPrerequisite[] @relation("LessonSide")
  requiredBy    LessonPrerequisite[] @relation("PrerequisiteSide")
  videoAssets   VideoAsset[]

  @@unique([moduleId, position])
  @@index([moduleId, isActive])
  @@map("lessons")
}

model LessonPrerequisite {
  lessonId             String @map("lesson_id") @db.Uuid
  prerequisiteLessonId String @map("prerequisite_lesson_id") @db.Uuid

  lesson       Lesson @relation("LessonSide", fields: [lessonId], references: [id], onDelete: Cascade)
  prerequisite Lesson @relation("PrerequisiteSide", fields: [prerequisiteLessonId], references: [id], onDelete: Cascade)

  @@id([lessonId, prerequisiteLessonId])
  @@map("lesson_prerequisites")
}

// ─────────────────────────────────────────────────────────────
// Enrollment and Progress
// ─────────────────────────────────────────────────────────────

model Enrollment {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  courseId       String           @map("course_id") @db.Uuid
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  accessStartsAt DateTime?        @map("access_starts_at") @db.Timestamptz(6)
  accessEndsAt   DateTime?        @map("access_ends_at") @db.Timestamptz(6)
  completedAt    DateTime?        @map("completed_at") @db.Timestamptz(6)
  removedAt      DateTime?        @map("removed_at") @db.Timestamptz(6)
  enrolledBy     String?          @map("enrolled_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user             User                   @relation("EnrollmentOwner", fields: [userId], references: [id], onDelete: Cascade)
  course           Course                 @relation(fields: [courseId], references: [id], onDelete: Restrict)
  actor            User?                  @relation("EnrollmentActor", fields: [enrolledBy], references: [id], onDelete: SetNull)
  courseProgress   CourseProgress?
  lessonProgress   LessonProgress[]
  playbackSessions VideoPlaybackSession[]

  @@unique([userId, courseId])
  @@index([courseId, status])
  @@map("enrollments")
}

// ─────────────────────────────────────────────────────────────
// Registration Commerce
// ─────────────────────────────────────────────────────────────

model AccessTier {
  id             String   @id @default(uuid()) @db.Uuid
  slug           String   @unique
  name           String
  description    String?
  priceIdr       Int      @map("price_idr")
  durationMonths Int?     @map("duration_months")
  isActive       Boolean  @default(true) @map("is_active")
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  courses AccessTierCourse[]
  orders  RegistrationOrder[]

  @@index([isActive, position])
  @@map("access_tiers")
}

model AccessTierCourse {
  tierId   String @map("tier_id") @db.Uuid
  courseId String @map("course_id") @db.Uuid
  position Int    @default(0)

  tier   AccessTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  course Course     @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@id([tierId, courseId])
  @@unique([tierId, position])
  @@map("access_tier_courses")
}

model RegistrationOrder {
  id                     String             @id @default(uuid()) @db.Uuid
  orderCode              String             @unique @map("order_code")
  tierId                 String             @map("tier_id") @db.Uuid
  fullName               String             @map("full_name")
  email                  String             @db.Citext
  phone                  String
  grossAmount            Int                @map("gross_amount")
  status                 PaymentOrderStatus @default(PENDING)
  paymentProvider        PaymentProvider    @default(MIDTRANS) @map("payment_provider")
  snapToken              String?            @map("snap_token")
  redirectUrl            String?            @map("redirect_url")
  providerTransactionId  String?            @map("provider_transaction_id")
  paymentType            String?            @map("payment_type")
  fraudStatus            String?            @map("fraud_status")
  paidAt                 DateTime?          @map("paid_at") @db.Timestamptz(6)
  accessStartsAt         DateTime?          @map("access_starts_at") @db.Timestamptz(6)
  accessEndsAt           DateTime?          @map("access_ends_at") @db.Timestamptz(6)
  provisionedUserId      String?            @map("provisioned_user_id") @db.Uuid
  emailDeliveryStatus    DeliveryStatus     @default(PENDING) @map("email_delivery_status")
  whatsAppDeliveryStatus DeliveryStatus     @default(PENDING) @map("whatsapp_delivery_status")
  deliveryError          String?            @map("delivery_error")
  expiresAt              DateTime           @map("expires_at") @db.Timestamptz(6)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tier            AccessTier            @relation(fields: [tierId], references: [id], onDelete: Restrict)
  provisionedUser User?                 @relation("ProvisionedRegistrationUser", fields: [provisionedUserId], references: [id], onDelete: SetNull)
  webhookEvents   PaymentWebhookEvent[]

  @@index([email, status])
  @@index([status, createdAt])
  @@map("registration_orders")
}

model PaymentWebhookEvent {
  id               String    @id @default(uuid()) @db.Uuid
  orderId          String    @map("order_id") @db.Uuid
  providerEventKey String    @unique @map("provider_event_key")
  payload          Json
  receivedAt       DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt      DateTime? @map("processed_at") @db.Timestamptz(6)

  order RegistrationOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, receivedAt])
  @@map("payment_webhook_events")
}

model VideoAsset {
  id              String        @id @default(uuid()) @db.Uuid
  lessonId        String        @map("lesson_id") @db.Uuid
  createdBy       String        @map("created_by") @db.Uuid
  provider        VideoProvider @default(SELF_HOSTED)
  providerVideoId String        @unique @map("provider_video_id")
  objectKey       String?       @map("object_key")
  originalName    String        @map("original_name")
  title           String
  mimeType        String        @map("mime_type")
  sizeBytes       BigInt        @map("size_bytes")
  status          VideoStatus   @default(CREATED)
  processingError String?       @map("processing_error")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)

  lesson           Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  creator          User                   @relation("VideoAssetCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  playbackSessions VideoPlaybackSession[]

  @@index([lessonId, status])
  @@map("video_assets")
}

model VideoPlaybackSession {
  id              String         @id @default(uuid()) @db.Uuid
  videoAssetId    String         @map("video_asset_id") @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  enrollmentId    String         @map("enrollment_id") @db.Uuid
  deviceId        String?        @map("device_id")
  status          PlaybackStatus @default(ACTIVE)
  expiresAt       DateTime       @map("expires_at") @db.Timestamptz(6)
  startedAt       DateTime       @default(now()) @map("started_at") @db.Timestamptz(6)
  lastHeartbeatAt DateTime?      @map("last_heartbeat_at") @db.Timestamptz(6)
  endedAt         DateTime?      @map("ended_at") @db.Timestamptz(6)

  videoAsset VideoAsset @relation(fields: [videoAssetId], references: [id], onDelete: Restrict)
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  @@index([userId, status, expiresAt])
  @@index([videoAssetId, status])
  @@map("video_playback_sessions")
}

model CourseProgress {
  id                      String    @id @default(uuid()) @db.Uuid
  enrollmentId            String    @unique @map("enrollment_id") @db.Uuid
  requiredLessonsTotal    Int       @default(0) @map("required_lessons_total")
  requiredLessonsComplete Int       @default(0) @map("required_lessons_completed")
  progressPercent         Decimal   @default(0) @map("progress_percent") @db.Decimal(5, 2)
  lastLessonId            String?   @map("last_lesson_id") @db.Uuid
  startedAt               DateTime? @map("started_at") @db.Timestamptz(6)
  lastActivityAt          DateTime? @map("last_activity_at") @db.Timestamptz(6)
  completedAt             DateTime? @map("completed_at") @db.Timestamptz(6)
  version                 Int       @default(0)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lastLesson Lesson?    @relation("LastLesson", fields: [lastLessonId], references: [id], onDelete: SetNull)

  @@map("course_progress")
}

model LessonProgress {
  id                 String               @id @default(uuid()) @db.Uuid
  enrollmentId       String               @map("enrollment_id") @db.Uuid
  lessonId           String               @map("lesson_id") @db.Uuid
  status             LessonProgressStatus @default(NOT_STARTED)
  viewCount          Int                  @default(0) @map("view_count")
  totalSeconds       Int                  @default(0) @map("total_seconds")
  firstOpenedAt      DateTime?            @map("first_opened_at") @db.Timestamptz(6)
  lastOpenedAt       DateTime?            @map("last_opened_at") @db.Timestamptz(6)
  completedAt        DateTime?            @map("completed_at") @db.Timestamptz(6)
  completionEvidence Json?                @map("completion_evidence")
  version            Int                  @default(0)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([lessonId, status])
  @@map("lesson_progress")
}

// ─────────────────────────────────────────────────────────────
// Transactional Outbox (ADR-004)
// ─────────────────────────────────────────────────────────────

model OutboxMessage {
  id            String    @id @default(uuid()) @db.Uuid
  eventId       String    @unique @map("event_id") @db.Uuid
  eventType     String    @map("event_type")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json
  schemaVersion Int       @default(1) @map("schema_version")
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")

  @@index([publishedAt, availableAt])
  @@map("outbox_messages")
}

/// Fakta perilaku belajar, ditulis worker dari outbox.
///
/// `eventUuid` menyimpan `outbox_messages.event_id`. Constraint unik pada kolom
/// itulah yang membuat konsumer idempotent: percobaan kedua atas event yang
/// sama gagal pada level database, bukan bergantung pada disiplin kode.
model LearningEvent {
  id              BigInt   @id @default(autoincrement())
  eventUuid       String   @unique @map("event_uuid") @db.Uuid
  eventName       String   @map("event_name")
  schemaVersion   Int      @default(1) @map("schema_version")
  userId          String?  @map("user_id") @db.Uuid
  learningSession String?  @map("session_id") @db.Uuid
  courseId        String?  @map("course_id") @db.Uuid
  moduleId        String?  @map("module_id") @db.Uuid
  lessonId        String?  @map("lesson_id") @db.Uuid
  occurredAt      DateTime @map("occurred_at") @db.Timestamptz(6)
  durationSeconds Int?     @map("duration_seconds")
  deviceType      String?  @map("device_type")
  source          String?
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, occurredAt])
  @@index([courseId, eventName, occurredAt])
  @@index([lessonId, eventName])
  @@map("learning_events")
}

/// Menyimpan hasil mutation idempotent supaya percobaan ulang dengan
/// Idempotency-Key yang sama mengembalikan respons yang sama.
model IdempotencyKey {
  id           String   @id @default(uuid()) @db.Uuid
  key          String
  userId       String   @map("user_id") @db.Uuid
  endpoint     String
  requestHash  String   @map("request_hash")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([userId, endpoint, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id") @db.Uuid
  beforeData  Json?    @map("before_data")
  afterData   Json?    @map("after_data")
  requestId   String?  @map("request_id") @db.Uuid
  ipAddress   String?  @map("ip_address") @db.Inet
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}
