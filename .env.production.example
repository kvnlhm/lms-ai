APP_DOMAIN=lms.example.com
APP_ENV=production
NODE_ENV=production
APP_NAME=LMS Akademi Online
PORT=3001
WEB_URL=https://lms.example.com
API_URL=http://api:3001
LOG_LEVEL=info

POSTGRES_USER=lms
POSTGRES_PASSWORD=replace-with-random-password
POSTGRES_DB=lms
DATABASE_URL=postgresql://lms:replace-with-url-encoded-password@postgres:5432/lms?schema=public

REDIS_PASSWORD=replace-with-random-password
REDIS_URL=redis://:replace-with-url-encoded-password@redis:6379
REDIS_SESSION_PREFIX=lms:session:
REDIS_CACHE_PREFIX=lms:cache:
REDIS_QUEUE_PREFIX=lms:queue:

SESSION_COOKIE_NAME=lms_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax
CSRF_COOKIE_NAME=lms_csrf
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=43200
REQUIRE_MASTER_MFA=true
MFA_ISSUER=LMS Akademi Online
MFA_ENCRYPTION_KEY=replace-with-32-byte-base64-key
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_MAX=10

VIDEO_PROVIDER=SELF_HOSTED
VIDEO_STORAGE_PATH=/data/videos
VIDEO_MAX_UPLOAD_BYTES=2147483648
VIDEO_PLAYBACK_TTL_SECONDS=300

QUEUE_CONCURRENCY_MAINTENANCE=2
QUEUE_CONCURRENCY_ANALYTICS=4
QUEUE_CONCURRENCY_NOTIFICATIONS=4
