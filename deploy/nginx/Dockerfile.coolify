FROM nginx:1.27-alpine

COPY deploy/nginx/coolify.conf.template /etc/nginx/templates/default.conf.template
# Halaman pemeliharaan ikut ke dalam image, bukan dipasang lewat volume: ia
# justru dibutuhkan tepat ketika layanan lain sedang tidak ada.
COPY deploy/nginx/pemeliharaan/ /usr/share/nginx/pemeliharaan/
# Logo harus hidup di gateway itu sendiri. Saat halaman pemeliharaan muncul,
# container Web justru sedang tidak dapat dijangkau, jadi mengambil ikon dari
# Next.js akan gagal pada saat ikon itu paling dibutuhkan.
COPY apps/web/app/logo-terang.webp /usr/share/nginx/pemeliharaan/__brand.webp
# Varian tinta terang untuk halaman pemeliharaan mode gelap. Lambang
# bertinta gelap hilang di sana, dan halaman itu justru muncul tepat
# ketika tidak ada yang dapat memperbaikinya dari sisi aplikasi.
COPY apps/web/app/logo-gelap.webp /usr/share/nginx/pemeliharaan/__brand-gelap.webp
