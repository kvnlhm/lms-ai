server {
    listen 8080;
    listen [::]:8080;
    server_name _;

    client_max_body_size ${VIDEO_MAX_UPLOAD_BYTES};

    # DNS internal Docker.
    #
    # Tanpa ini nginx menerjemahkan nama `api` dan `web` satu kali saat menyala,
    # lalu memakai alamat itu selamanya. Selama gateway ikut dibuat ulang pada
    # setiap deploy hal itu tidak pernah terasa — nginx selalu baru. Begitu
    # gateway bertahan hidup melewati deploy, container di belakangnya berganti
    # alamat dan nginx akan terus menembak alamat mati sampai ada yang sadar.
    #
    # `valid=10s` membatasi berapa lama hasil terjemahan disimpan, sehingga
    # gateway mengikuti container baru dalam hitungan detik.
    resolver 127.0.0.11 valid=10s ipv6=off;
    # Bila DNS internal sendiri tidak menjawab, permintaan harus gagal cepat
    # lalu jatuh ke halaman pemeliharaan. Tanpa batas ini nginx menggantung
    # menunggu jawaban yang tidak akan datang, dan pengunjung melihat halaman
    # kosong yang berputar — lebih buruk daripada pesan yang jujur.
    resolver_timeout 3s;
    proxy_connect_timeout 3s;

    # Kesehatan gateway itu sendiri, tidak menyentuh api maupun web.
    #
    # Sebelumnya healthcheck container ini memanggil /api/v1/health/live lewat
    # dirinya sendiri, sehingga gateway dinyatakan sakit selama API belum
    # menyala. Itu keliru: yang ingin diketahui adalah "nginx melayani", bukan
    # "seluruh tumpukan sudah siap" — dan dengan syarat lama gateway tidak
    # pernah bisa menyala lebih dulu untuk menyajikan halaman pemeliharaan.
    location = /__gateway-health {
        access_log off;
        add_header Content-Type text/plain always;
        return 200 'ok';
    }

    location /api/ {
        # Lewat variabel, bukan nama langsung: hanya bentuk inilah yang membuat
        # nginx menerjemahkan ulang nama tiap kali, bukan sekali saat menyala.
        # Karena memakai variabel, URI aslinya harus disebut eksplisit —
        # sebaliknya nginx akan meneruskan permintaan tanpa path.
        set $api_upstream "api:3001";
        proxy_pass http://$api_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        # Hanya berlaku ketika nginx sendiri gagal menjangkau API. Galat 5xx
        # yang datang *dari* API diteruskan apa adanya, karena `proxy_intercept_errors`
        # sengaja dibiarkan mati — menelan badan JSON milik API dan menggantinya
        # dengan halaman akan merusak setiap klien yang membacanya.
        error_page 502 503 504 = @api_tidak_tersedia;
    }

    # Balasan untuk pemanggil API: JSON, bukan halaman, dengan bentuk amplop
    # galat yang sama seperti yang dipakai API.
    location @api_tidak_tersedia {
        default_type application/json;
        add_header Retry-After 20 always;
        add_header Cache-Control "no-store" always;
        return 503 '{"error":{"code":"SERVICE_UNAVAILABLE","message":"Layanan sedang diperbarui. Coba lagi sebentar lagi."}}';
    }

    # Hanya respons X-Accel-Redirect dari API yang dapat membuka file.
    location /protected-videos/ {
        internal;
        alias /data/videos/;
        add_header Cache-Control "private, no-store" always;
        add_header Content-Disposition "inline" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Accept-Ranges bytes always;
        types { video/mp4 mp4; }
    }

    # Materi terlindungi, mengikuti pola yang sama dengan video: hanya dapat
    # dicapai lewat X-Accel-Redirect dari API, jadi tidak ada URL publik yang
    # bisa disalin. `inline` supaya PDF terbuka di penampil browser, bukan
    # langsung terunduh.
    location /protected-materials/ {
        internal;
        alias /data/materials/;
        add_header Cache-Control "private, no-store" always;
        add_header Content-Disposition "inline" always;
        add_header X-Content-Type-Options "nosniff" always;
        types { application/pdf pdf; }
    }

    location /protected-community-attachments/ {
        internal;
        alias /data/community-attachments/;
        # `no-cache`, bukan `no-store`, dan harus sama dengan yang dipasang API.
        # Blok ini menimpa header dari upstream, jadi `no-store` di sini membuat
        # perubahan di NestJS tidak pernah sampai ke browser. Salinannya boleh
        # disimpan tetapi wajib divalidasi ulang: otorisasi tetap berjalan pada
        # setiap permintaan, sementara umpan yang digulir naik-turun berhenti
        # mengunduh gambar yang sama berkali-kali. Nginx menjawab revalidasinya
        # dengan 304 dari ETag berkas.
        add_header Cache-Control "private, no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Accept-Ranges bytes always;
        types { image/jpeg jpg jpeg; image/png png; image/webp webp; video/mp4 mp4; video/webm webm; application/pdf pdf; }
    }

    location / {
        set $web_upstream "web:3000";
        proxy_pass http://$web_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

        # `=503` menyeragamkan statusnya. Tanpa itu halaman ini terkirim dengan
        # 502, yang berarti "gateway rusak" — padahal yang benar adalah
        # "sementara tidak tersedia", dan hanya 503 yang dipasangkan dengan
        # Retry-After oleh peramban maupun mesin pengindeks.
        error_page 502 503 504 =503 /__pemeliharaan.html;
    }

    # Halaman yang dilihat pengunjung selama web berganti container. Jauh lebih
    # baik daripada "no available server" milik Traefik, yang terbaca seperti
    # situsnya hilang.
    location = /__pemeliharaan.html {
        internal;
        root /usr/share/nginx/pemeliharaan;
        add_header Retry-After 20 always;
        add_header Cache-Control "no-store" always;
    }

    # Aset halaman pemeliharaan dilayani langsung oleh gateway. Jangan jadikan
    # internal: browser perlu meminta gambar ini setelah menerima HTML 503.
    location = /__brand.png {
        root /usr/share/nginx/pemeliharaan;
        add_header Cache-Control "no-store" always;
    }
}
