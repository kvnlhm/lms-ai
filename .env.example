# Salin ke .env lalu isi nilainya. File ini hanya berisi placeholder.
# Lihat docs/operations/ENVIRONMENT_VARIABLES.md untuk daftar lengkap.

# ── Application ────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=local
APP_NAME=LMS Akademi Online
APP_URL=http://localhost:3000
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
PORT=3001
LOG_LEVEL=debug

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql://lms:lms_local_password@localhost:5432/lms?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_SESSION_PREFIX=lms:session:
REDIS_CACHE_PREFIX=lms:cache:
REDIS_QUEUE_PREFIX=lms:queue:
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=43200
QUEUE_CONCURRENCY_MAINTENANCE=2

# ── Authentication ─────────────────────────────────────────────
SESSION_COOKIE_NAME=lms_session
SESSION_COOKIE_DOMAIN=localhost
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
CSRF_COOKIE_NAME=lms_csrf
PASSWORD_RESET_TTL_MINUTES=30
MFA_ISSUER=LMS Akademi Online
REQUIRE_MASTER_MFA=true
# Kunci AES-256 base64 untuk rahasia TOTP. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Mengganti kunci ini membuat seluruh MFA yang sudah terdaftar tidak terbaca.
MFA_ENCRYPTION_KEY=
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_MAX=10

# ── Registrasi berbayar (ADR-016) ─────────────────────────────
REGISTRATION_ORDER_TTL_MINUTES=1440
MIDTRANS_ENVIRONMENT=SANDBOX
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
EMAIL_PROVIDER=DISABLED
RESEND_API_KEY=
EMAIL_FROM_NAME=Academy AIPreneur
EMAIL_FROM_ADDRESS=
WHATSAPP_PROVIDER=DISABLED
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ACTIVATION_TEMPLATE_NAME=academy_account_activation
WHATSAPP_TEMPLATE_LANGUAGE=id
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ── Web (client-side, tidak boleh berisi secret) ───────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Video (ADR-014) ───────────────────────────────────────────
VIDEO_PROVIDER=SELF_HOSTED
VIDEO_STORAGE_PATH=/data/videos
AVATAR_STORAGE_PATH=/data/avatars
AVATAR_MAX_UPLOAD_BYTES=5242880
COURSE_THUMBNAIL_STORAGE_PATH=/data/course-thumbnails
COURSE_THUMBNAIL_MAX_UPLOAD_BYTES=5242880
VIDEO_MAX_UPLOAD_BYTES=2147483648
VIDEO_PLAYBACK_TTL_SECONDS=300
